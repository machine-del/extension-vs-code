{
  "templates": {
    "loginMySqli": {
      "command": "extension-vs-code.application",
      "prefix": "de_app",
      "template": [
        "// Login logic",
        "function loginUser(username, password) {",
        "  // TODO: Implement login logic here",
        "  console.log(`Logging in user: ${username}`);",
        "}",
        "",
        "// Example usage",
        "loginUser('exampleUser', 'examplePassword');"
      ]
    },
    "loginFunc": {
      "command": "extension-vs-code.applicationFunc",
      "prefix": "de_reqFunc",
      "template": [
        "function createRequest($conn, $id_user, $course, $date, $payment)",
        "{",
        "    $sql = \"INSERT INTO `request` (`id_user`, `course_name`, `start_date`, `payment_method`, `status`) VALUES ('$id_user','$course','$date','$payment','Новая')\";",
        "    if ($conn->query($sql)) {",
        "        return true;",
        "    }",
        "    return false;",
        "}",
        "",
        "function getUserRequests($conn, $id_user)",
        "{",
        "    $sql = \"SELECT * FROM `request` WHERE id_user='$id_user' ORDER BY id DESC\";",
        "    $result = $conn->query($sql);",
        "    $requests = array();",
        "    while ($row = $result->fetch_assoc()) {",
        "        $requests[] = $row;",
        "    }",
        "    return $requests;",
        "}",
        "",
        "function getAllRequests($conn)",
        "{",
        "    $sql = \"SELECT r.*, u.login, u.fio FROM `request` r JOIN users u ON r.id_user = u.id ORDER BY r.id DESC\";",
        "    $result = $conn->query($sql);",
        "    $requests = array();",
        "    while ($row = $result->fetch_assoc()) {",
        "        $requests[] = $row;",
        "    }",
        "    return $requests;",
        "}",
        "",
        "function updateRequestStatus($conn, $id, $status)",
        "{",
        "    $sql = \"UPDATE `request` SET status='$status' WHERE id='$id'\";",
        "    if ($conn->query($sql)) {",
        "        return true;",
        "    }",
        "    return false;",
        "}",
        "",
        "function createReview($conn, $id_request, $id_user, $rating, $text)",
        "{",
        "    $sql = \"INSERT INTO `review` (`id_request`, `id_user`, `rating`, `review_text`) VALUES ('$id_request','$id_user','$rating','$text')\";",
        "    if ($conn->query($sql)) {",
        "        return true;",
        "    }",
        "    return false;",
        "}",
        "",
        "function getRequestById($conn, $id)",
        "{",
        "    $sql = \"SELECT * FROM `request` WHERE id='$id'\";",
        "    $result = $conn->query($sql);",
        "    if ($result->num_rows > 0) {",
        "        return $result->fetch_assoc();",
        "    }",
        "    return null;",
        "}",
        "",
        "function getReviewByRequest($conn, $id_request)",
        "{",
        "    $sql = \"SELECT * FROM `review` WHERE id_request='$id_request'\";",
        "    $result = $conn->query($sql);",
        "    if ($result->num_rows > 0) {",
        "        return $result->fetch_assoc();",
        "    }",
        "    return null;",
        "}"
      ]
    }
  }
}
