    "loginFunc": {
      "command": "extension-vs-code.regFunc",
      "prefix": "de_regFunc",
      "template": [
        "function register($conn, $id_role, $login, $password, $fio, $phone, $email)",
        "{",
        "    $sqlCheck = \"SELECT id FROM users WHERE login='$login'\";",
        "    $q = $conn->query($sqlCheck);",
        "    if ($q->num_rows > 0) {",
        "        return \"Логин уже занят\";",
        "    };",
        "",
        "    $sql = \"INSERT INTO `users` (`id_role`, `login`, `password`, `fio`, `phone`, `email`) VALUES ('$id_role','$login','$password','$fio','$phone','$email')\";",
        "    if ($conn->query($sql)) {",
        "        return true;",
        "    }",
        "    return \"Ошибка регистрации\";",
        "}"
      ]
    }
