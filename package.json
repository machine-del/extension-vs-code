{
  "name": "extension-vs-code",
  "displayName": "Extension VS Code",
  "description": "PHP code snippets extension for VS Code",
  "version": "0.0.1",
  "publisher": "your-publisher-name",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-repo/extension-vs-code"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:php"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension-vs-code.db",
        "title": "DB: Create Database Connection"
      },
      {
        "command": "extension-vs-code.adminCommand1",
        "title": "Admin: Function 1"
      },
      {
        "command": "extension-vs-code.adminCommand2",
        "title": "Admin: Function 2"
      },
      {
        "command": "extension-vs-code.login",
        "title": "Auth: Login JavaScript Template"
      },
      {
        "command": "extension-vs-code.loginFunc",
        "title": "Auth: Login PHP Function"
      },
      {
        "command": "extension-vs-code.reg",
        "title": "Auth: Register JavaScript Template"
      },
      {
        "command": "extension-vs-code.regFunc",
        "title": "Auth: Register PHP Function"
      },
      {
        "command": "extension-vs-code.application",
        "title": "Application: JavaScript Template"
      },
      {
        "command": "extension-vs-code.applicationFunc",
        "title": "Application: PHP Functions"
      },
      {
        "command": "extension-vs-code.requestApplication",
        "title": "Request: Application Template"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
